{
  "name": "@tested/cli",
  "version": "0.1.6",
  "description": "Coverage your agent can use. CLI for patch + project coverage with agent-readable JSON output.",
  "license": "MIT",
  "homepage": "https://tested.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tested-hq/cli.git"
  },
  "bugs": {
    "url": "https://github.com/tested-hq/cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "tested": "./dist/tested.js",
    "td": "./dist/tested.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/tested.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "node ./scripts/prepare.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "14.0.3",
    "minimatch": "10.2.5",
    "picocolors": "1.1.1",
    "simple-git": "3.36.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "husky": "9.1.7",
    "is-ci": "3.0.1",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
