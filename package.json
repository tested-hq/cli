{
  "name": "@tested/cli",
  "version": "0.0.1",
  "description": "Coverage your agent can use. CLI for patch + project coverage with agent-readable JSON output.",
  "private": true,
  "type": "module",
  "bin": {
    "tested": "./dist/tested.js",
    "td": "./dist/td.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/tested.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "12.1.0",
    "minimatch": "10.0.1",
    "picocolors": "1.1.1",
    "simple-git": "3.27.0",
    "yaml": "2.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "husky": "^9.1.7",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
