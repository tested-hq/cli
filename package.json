{
  "name": "@tested/cli",
  "version": "0.0.1",
  "description": "Coverage your agent can use. CLI for patch + project coverage with agent-readable JSON output.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "tested": "./dist/tested.js",
    "td": "./dist/td.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/tested.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "is-ci || husky"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "14.0.3",
    "minimatch": "10.2.5",
    "picocolors": "1.1.1",
    "simple-git": "3.36.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "husky": "9.1.7",
    "is-ci": "3.0.1",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
